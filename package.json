{
  "name": "reservation-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run verify:contracts",
    "test:contracts": "node scripts/verify-contracts.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "smoke:public": "node scripts/smoke-public.mjs",
    "audit:staging-security": "node scripts/staging-security-audit.mjs",
    "audit:staging-booking": "node scripts/staging-booking-audit.mjs",
    "audit:staging-commerce": "node scripts/staging-commerce-audit.mjs",
    "audit:staging-notifications": "node scripts/staging-notification-audit.mjs",
    "audit:staging-browser-identity": "node scripts/staging-browser-identity-audit.mjs",
    "audit:staging-core": "node scripts/staging-core-acceptance.mjs",
    "audit:staging-role-ui": "playwright test tests/staging-role-ui.spec.mjs --reporter=line",
    "audit:staging-growth": "node scripts/staging-growth-features-audit.mjs",
    "fixture:staging-roles": "node scripts/staging-role-fixture.mjs",
    "reminders": "node scripts/trigger-reminders.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {

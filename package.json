    "@fullcalendar/luxon3": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.112.4",
    "luxon": "^3.7.2",
    "next": "^15.5.22",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-is": "^19.1.0",
    "recharts": "^3.10.1",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^20.14.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.19",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.5.4"
  }

# ── Supabase ───────────────────────────────────────────────
# 專案 URL 與兩把金鑰(Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# anon key 視為公開資訊,僅後台 Auth 流程使用
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service role key 只在 server 端使用,絕不可放進 NEXT_PUBLIC_* 或 client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 相容部署 fallback(正式 SaaS 以登入後 active brand context 為準) ──
# clinics 表的預設品牌 id；僅供公開舊入口與單品牌相容部署
NEXT_PUBLIC_CLINIC_ID=00000000-0000-0000-0000-000000000000
# 共享公開入口的正式 host；未設定時僅允許 localhost 與 *.vercel.app 使用上述 fallback
PUBLIC_SHARED_HOSTS=booking.example.com

# ── LINE ───────────────────────────────────────────────────
# Messaging API channel(後台 → Channel access token / secret)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
# 多品牌 webhook(選用):以 LINE payload 的 destination 為 key 的 JSON；密鑰只放 server environment。
LINE_CHANNEL_ACCESS_TOKENS_JSON={"UbotA":"token-a","UbotB":"token-b"}
LINE_CHANNEL_SECRETS_JSON={"UbotA":"secret-a","UbotB":"secret-b"}
# Email 金鑰與寄件人依 clinic_id 隔離，只能放 server environment，不可存入資料庫
RESEND_API_KEYS_JSON={"<clinic-uuid>":"re_..."}
RESEND_EMAIL_FROM_JSON={"<clinic-uuid>":"品牌名稱 <noreply@example.com>"}
# 單品牌相容 fallback
RESEND_API_KEY=
RESEND_EMAIL_FROM=
# 金流密鑰依 clinic_id 隔離，只能放 server environment；後台只保存商店識別與環境
PAYMENT_SECRETS_JSON={"<clinic-uuid>":{"hashKey":"...","hashIv":"..."}}
# LIFF channel id(驗 ID token 用,通常為 LINE Login channel id)
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
# 病患端 LIFF 入口(前端用)
NEXT_PUBLIC_LIFF_ID=your-liff-id
# 瀏覽器備援預約 token 簽章密鑰（至少 32 字元，只放 server environment）
BROWSER_BOOKING_SECRET=replace-with-a-long-random-secret
BROWSER_BOOKING_TOKEN_TTL_SECONDS=86400

# ── Cron ───────────────────────────────────────────────────
# Vercel Cron 呼叫提醒 endpoint 時帶的密鑰
CRON_SECRET=generate-a-long-random-string
# 看診前幾小時發提醒(預設 24)
REMINDER_HOURS_BEFORE=24
# 註:Email 提醒改由後台「診所設定 → Email 看診提醒」自行填入 Resend 金鑰,不走環境變數。
# 公開 canonical web URL；付款回呼／回跳與 Railway cron 都使用它
# (或改設 CRON_TARGET_URL 指定完整 endpoint URL)
APP_URL=https://your-app.up.railway.app
# Optional overrides when the cron worker calls different public endpoints.
CRON_TARGET_URL=
CRON_MARKETING_TARGET_URL=
CRON_REGISTRATION_TARGET_URL=

{
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "node --check scripts/run-allowlisted-cron.mjs"
  },
  "deploy": {
    "startCommand": "node scripts/run-allowlisted-cron.mjs --jobs=followups,registration,richmenu",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER"
  }
}
